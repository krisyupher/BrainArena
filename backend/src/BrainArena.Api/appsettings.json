{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=brainarena;Username=brainarena;Password=brainarena_dev_password"
  },
  "Jwt": {
    "Issuer": "BrainArena",
    "Audience": "BrainArena",
    "SigningKey": "dev-only-signing-key-change-before-any-real-deployment-32bytes+",
    "ExpiryDays": 7
  },
  "Admin": {
    "Email": "admin@brainarena.local",
    "Password": "ChangeMe123!",
    "DisplayName": "Admin"
  },
  "Cors": {
    "AllowedOrigin": "http://localhost:4200"
  },
  "MatchTiming": {
    "CountdownSeconds": 5,
    "RevealSeconds": 5
  },
  "RateLimiting": {
    "Auth": { "TokenLimit": 20, "TokensPerMinute": 6 },
    "GuestCreation": { "TokenLimit": 30, "TokensPerMinute": 2 },
    "RoomCreation": { "TokenLimit": 20, "TokensPerMinute": 10 }
  },
  "GuestCleanup": {
    "Enabled": true,
    "IntervalMinutes": 60
  }
}
